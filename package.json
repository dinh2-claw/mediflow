{
  "name": "mediflow-ui",
  "version": "0.1.0",
  "private": true,
  "module": "./dist/index.mjs",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "build:lib": "npm run build:js && npm run build:css && cp dist/index.d.mts dist/index.d.ts",
    "build:js": "tsup src/ui/index.ts --format esm --dts --out-dir dist --tsconfig tsconfig.build.json --external react --external react-dom",
    "build:css": "tailwindcss -i ./src/ui/styles.css -o ./dist/styles.css"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsup": "^8",
    "typescript": "^5"
  }
}
